{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Current File (.venv)",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "python": "${workspaceFolder}${pathSeparator}.venv${pathSeparator}bin${pathSeparator}python",
      "pythonArgs": ["-Xfrozen_modules=off"],
      "subProcess": false,
      "windows": {
        "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
      },
      "cwd": "${fileDirname}",
      "console": "integratedTerminal"
    }
  ]
}
